# =============================================================================
# tt-qimen 桌面端构建期环境变量样例（Tauri）
#
# 用法：
#   1. 复制为 .env.desktop.local（不会被 git 追踪）
#   2. 仅在本地打签名版本时需要；CI 通过 GitHub Secrets 注入同名变量
#   3. 这些变量给 tauri-action 与 tauri-cli 使用，前端代码不读取
# =============================================================================

# -----------------------------------------------------------------------------
# Tauri Updater 签名（macOS / Windows 自动更新均需要）
# -----------------------------------------------------------------------------
# 一次性生成：
#   npm run tauri signer generate -- -w ~/.tauri/tt-qimen.key
# 把公钥（base64 字符串）填入 src-tauri/tauri.conf.json plugins.updater.pubkey
# 私钥与密码放在下方两个变量
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# -----------------------------------------------------------------------------
# Apple Developer 签名 + 公证（仅 macOS 打分发包需要）
# -----------------------------------------------------------------------------
# Developer ID Application 证书（p12 文件 → base64）：
#   base64 -i developer_id.p12 | pbcopy
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=

# 证书内 Common Name，形如：Developer ID Application: Your Name (TEAMID)
APPLE_SIGNING_IDENTITY=

# 公证（notarytool）凭据
# APPLE_PASSWORD 是 app-specific password（不是 Apple ID 主密码）：
#   https://appleid.apple.com/account/manage → App-Specific Passwords
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# -----------------------------------------------------------------------------
# Windows 代码签名（可选；不配则首次启动出现 SmartScreen 警告）
# -----------------------------------------------------------------------------
# 证书指纹（SHA1 hex）。本地可用 certutil -store My 查看
WINDOWS_CERTIFICATE_THUMBPRINT=
